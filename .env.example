# Copy this file to .env.local for local development (npm run dev).
# For the live deployed site, these same values go into
# GitHub repo Settings → Secrets and variables → Actions → New repository secret
# (one secret per line below, same names).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=https://yourusername.github.io/joel-hq/
